{
  "name": "real-estate-backend",
  "version": "1.0.0",
  "description": "Backend API for Real Estate Marketplace",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "dev:test": "jest --watchAll",
    "test:notifications-escrow": "node scripts/testNotificationsEscrow.js",
    "migrate": "node migration/run-migration.js",
    "verify-migration": "node verify-migration.js",
    "test-db": "node test-db-connection.js",
    "db:local:start": "docker compose -f docker/local-postgres.yml up -d",
    "db:local:stop": "docker compose -f docker/local-postgres.yml down",
    "db:migrate:local": "node migrations/add_verified_to_verification_enums.js",
    "start:with-local-db": "node run_server_with_env.js \"postgresql://postgres:password@localhost:15432/real_estate_db\" false false",
    "db:backup": "node scripts/backup-local-db.js",
    "db:migrate:production": "node scripts/migrate-to-production.js",
    "db:migrate:critical": "node scripts/migrate-critical-data.js",
    "db:setup:render": "node scripts/setup-render-db.js"
  },
  "keywords": [
    "real-estate",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@azure/storage-blob": "^12.14.2",
    "axios": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cookie": "^1.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.2.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.18.0",
    "pg-hstore": "^2.3.4",
    "real-estate-marketplace": "file:..",
    "sequelize": "^6.37.7",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "stripe": "^13.5.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "nodemon": "^3.0.1"
  },
  "overrides": {
    "serialize-javascript": "^6.0.2",
    "ws": "^8.18.3",
    "shell-quote": "^1.8.2",
    "socket.io-parser": "^4.2.6",
    "socket.io-adapter": "^2.5.7",
    "engine.io": "^6.6.8",
    "engine.io-client": "^6.6.5",
    "websocket-driver": "^0.7.5",
    "qs": "^6.15.2",
    "body-parser": "^1.20.6",
    "underscore": "^1.13.8",
    "undici": "^7.0.0",
    "tar": "^7.5.21",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.15.12",
    "node-forge": "^1.3.4",
    "brace-expansion": "^2.0.2",
    "picomatch": "^2.3.2",
    "flatted": "^3.4.2",
    "fast-xml-parser": "^5.6.1",
    "fast-uri": "^3.1.4",
    "ip-address": "^10.1.1",
    "joi": "^17.13.4",
    "js-yaml": "^4.1.0",
    "tmp": "^0.2.6",
    "nth-check": "^2.1.1",
    "sockjs": "^0.3.24",
    "http-proxy-middleware": "^2.0.10",
    "launch-editor": "^2.14.1",
    "esbuild": "^0.28.0",
    "basic-ftp": "^6.0.0",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
