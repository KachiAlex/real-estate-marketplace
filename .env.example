# ============================================================================
# PropertyArk Mobile Development Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the values for your environment
# DO NOT commit .env.local to version control
# ============================================================================

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
REACT_APP_ENVIRONMENT=development
REACT_APP_VERSION=1.0.1

# ============================================================================
# API Configuration
# ============================================================================
# Development API endpoint
REACT_APP_API_URL=http://localhost:5001
# Staging API endpoint (for staging builds)
# REACT_APP_API_URL=https://staging-api.propertyark.com
# Production API endpoint (for production builds)
# REACT_APP_API_URL=https://api.propertyark.com

# ============================================================================
# Database Configuration (Backend)
# ============================================================================
# PostgreSQL - Local Development
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=15432
DB_NAME=real_estate_db
DB_REQUIRE_SSL=false
DB_REJECT_UNAUTHORIZED=false
DATABASE_URL_LOCAL=postgresql://postgres:password@localhost:15432/real_estate_db

# PostgreSQL - Production (Neon Database)
DATABASE_URL=postgresql://neondb_owner:npg_xUZQWBfyGt79@ep-noisy-resonance-am77s3ty-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ============================================================================
# Authentication & Security
# ============================================================================
# JWT Secrets (use strong secrets for production)
JWT_SECRET=dev-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Vercel Production URL (same project hosts frontend + backend)
# REACT_APP_API_URL=https://propertyark.vercel.app/api

# ============================================================================
# Mobile Build Configuration
# ============================================================================
# Capacitor Configuration
CAPACITOR_ANDROID_STUDIO_PATH=/Applications/Android\ Studio.app
CAPACITOR_XCODE_PATH=/Applications/Xcode.app

# EAS Build Configuration
EAS_PROJECT_ID=your-eas-project-id
EAS_BUILD_PROFILE=development

# ============================================================================
# Android Build Configuration
# ============================================================================
# Android SDK Configuration
ANDROID_SDK_ROOT=$HOME/Library/Android/sdk
ANDROID_HOME=$HOME/Library/Android/sdk
ANDROID_NDK_HOME=$HOME/Library/Android/sdk/ndk/25.1.8937393

# Android Keystore Configuration (for release builds)
ANDROID_KEYSTORE_PATH=path/to/keystore.jks
ANDROID_KEYSTORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=propertyark-key
ANDROID_KEY_PASSWORD=your-key-password

# Android Build Configuration
ANDROID_MIN_SDK_VERSION=21
ANDROID_TARGET_SDK_VERSION=34
ANDROID_BUILD_TOOLS_VERSION=34.0.0

# ============================================================================
# iOS Build Configuration
# ============================================================================
# iOS Development Team ID
IOS_TEAM_ID=your-apple-team-id

# iOS Bundle Identifier
IOS_BUNDLE_ID=com.propertyark.app

# iOS Deployment Target
IOS_DEPLOYMENT_TARGET=14.0

# iOS Code Signing Configuration
IOS_CERTIFICATE_ID=your-certificate-id
IOS_PROVISIONING_PROFILE_ID=your-provisioning-profile-id

# ============================================================================
# Third-Party Services
# ============================================================================
# Google Maps API Key
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_GOOGLE_CLIENT_SECRET=your-google-client-secret

# SendGrid Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@propertyark.com

# Paystack Payment Configuration
REACT_APP_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ============================================================================
# Analytics & Monitoring
# ============================================================================
# Sentry Configuration (for error tracking)
REACT_APP_SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Analytics Token
REACT_APP_ANALYTICS_TOKEN=your-analytics-token

# ============================================================================
# Development Server Configuration
# ============================================================================
PORT=5001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5001

# ============================================================================
# Feature Flags
# ============================================================================
REACT_APP_ENABLE_LIVE_CHAT=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_TRACKING=true

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=debug
REACT_APP_LOG_LEVEL=debug

# ============================================================================
# Build Artifact Configuration
# ============================================================================
# Output directory for build artifacts
BUILD_OUTPUT_DIR=./build
APK_OUTPUT_DIR=./android/app/build/outputs/apk
AAB_OUTPUT_DIR=./android/app/build/outputs/bundle
IPA_OUTPUT_DIR=./ios/build/outputs
