  "private": true,
  "main": "backend/server.js",
  "proxy": "http://localhost:5001",
  "homepage": "/",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true CI=false GENERATE_SOURCEMAP=false react-scripts build",
    "frontend:build": "cross-env DISABLE_ESLINT_PLUGIN=true CI=false GENERATE_SOURCEMAP=false react-scripts build",
    "build:mobile": "cross-env DISABLE_ESLINT_PLUGIN=true CI=false react-scripts build && npx cap sync",
    "build:android": "npm run build:mobile && npx cap open android",
    "build:ios": "npm run build:mobile && npx cap open ios",
    "cap:sync": "npm run build && npx cap sync",
    "frontend:start": "react-scripts start",
    "frontend:test": "cross-env SKIP_PREFLIGHT_CHECK=true CI=true react-scripts test --runInBand --watch=false",
    "frontend:test:ci": "cross-env NODE_OPTIONS=--max-old-space-size=4096 SKIP_PREFLIGHT_CHECK=true CI=true react-scripts test --runInBand --watch=false",
    "frontend:eject": "react-scripts eject",
    "frontend:serve": "serve -s build",
    "build:prod:sourcemap": "set GENERATE_SOURCEMAP=true && react-scripts build",
    "serve:prod": "serve -s build -l 5000",
    "capture:prod": "node scripts/headless-capture.cjs http://localhost:5000/",
    "dev:full": "concurrently \"npm run dev\" \"npm run frontend:start\"",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless",
    "test:e2e:local": "set CYPRESS_BASE_URL=http://localhost:3001 && cypress run",
    "test:all": "npm run test:e2e:headless",
    "test:comprehensive": "npm run test:e2e:headless",
    "test:phase4": "jest --config backend/tests/jest.phase4.config.js --runInBand",
    "test:phase4:open-handles": "jest --config backend/tests/jest.phase4.config.js --runInBand --detectOpenHandles --openHandlesTimeout=5000",
    "lint:add-property": "eslint src/pages/AddProperty.js src/contexts/PropertyContext.js --max-warnings=0",
    "sync:api-backend": "node scripts/sync-api-backend.cjs"
  },
