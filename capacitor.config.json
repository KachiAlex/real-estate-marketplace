{
  "appId": "com.propertyark.app",
  "appName": "PropertyArk",
  "webDir": "build",
  "server": {
    "url": "https://propertyark.vercel.app",
    "cleartext": false,
    "allowNavigation": [
      "propertyark.vercel.app"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
